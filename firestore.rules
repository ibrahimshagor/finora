rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || request.auth.uid != null);
    }

    // User profile document and all subcollections
    match /users/{userId} {
      allow read, write: if true;

      // Allow all subcollections under users/{userId} (accounts, transactions, loans, budgets, savingsGoals, bills, investments, categories)
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Direct root collections fallback if queried at root
    match /accounts/{accountId} {
      allow read, write: if true;
    }

    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /loans/{loanId} {
      allow read, write: if true;
    }

    match /budgets/{budgetId} {
      allow read, write: if true;
    }

    match /savingsGoals/{goalId} {
      allow read, write: if true;
    }

    match /bills/{billId} {
      allow read, write: if true;
    }

    match /investments/{investmentId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Test connection endpoint
    match /test/{docId} {
      allow read, write: if true;
    }

    // Global match for any document
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

